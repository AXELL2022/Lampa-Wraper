{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lampa",
  "version": "1.0.0",
  "identifier": "com.lampa.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build:lampa",
    "frontendDist": "../lampa-source/build/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lampa",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
